{
	"name": "pottkinder/typo3forum",
	"description": "Forum extension",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"require": {
		"php": "^8.2",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-core": "^14.3",
		"typo3/cms-extbase": "^14.3",
		"typo3/cms-fluid": "^14.3",
		"typo3/cms-frontend": "^14.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5",
		"helmich/typo3-typoscript-lint": "^3.3",
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpstan/phpstan": "^2.2"
	},
	"replace": {
		"typo3-ter/typo3_forum": "self.version"
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"preferred-install": "dist",
		"allow-plugins": {
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true
		}
	},
	"autoload": {
		"psr-4": {
			"Mittwald\\Typo3Forum\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Mittwald\\Typo3Forum\\Tests\\": "Tests"
		}
	},
	"scripts": {
		"php-lint": "@php Build/php-lint.php",
		"test": "@php .Build/bin/phpunit",
		"phpstan": "@php .Build/bin/phpstan analyse --no-progress",
		"cs-check": "@php .Build/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
		"typoscript-lint": "@php .Build/bin/typoscript-lint -c typoscript-lint.yml",
		"ci": [
			"@composer validate",
			"@php-lint",
			"@test",
			"@phpstan",
			"@typoscript-lint",
			"@cs-check"
		]
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "typo3_forum",
			"web-dir": ".Build/Web"
		}
	}
}
