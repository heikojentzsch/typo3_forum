{
	"name": "pottkinder/typo3forum",
	"description": "Forum extension",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"repositories": [
		{
			"type": "composer",
			"url": "https://composer.typo3.org/"
		}
	],
	"require": {
		"php": "^8.2",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-core": "^14.3",
		"typo3/cms-extbase": "^14.3",
		"typo3/cms-fluid": "^14.3",
		"typo3/cms-frontend": "^14.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5",
		"helmich/typo3-typoscript-lint": "^3.3",
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpmd/phpmd": "^2.9",
		"phpstan/phpstan": "^0.12.52",
		"psalm/phar": "^4.0"
	},
	"replace": {
		"typo3-ter/typo3_forum": "self.version"
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"preferred-install": {
			"typo3/cms": "source"
		},
		"allow-plugins": {
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true
		}
	},
	"autoload": {
		"psr-4": {
			"Mittwald\\Typo3Forum\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Mittwald\\Typo3Forum\\Tests\\": "Tests"
		}
	},
	"scripts": {
		"php-lint": [
			"find Classes Configuration Tests -name '*.php' -print0 | xargs -0 -n1 php -l"
		],
		"php-cs-fixer": [
			"@php .Build/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff Classes",
			"@php .Build/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff Configuration"
		]
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0.x-dev"
		},
		"typo3/cms": {
			"extension-key": "typo3_forum",
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"web-dir": ".Build/Web"
		}
	}
}
