{
  "name": "typo3-forum-editors",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "playwright test",
    "format": "prettier --write \"*.{js,mjs,json}\" \"../../Public/CSS/*.css\" \"../../Public/Javascript/bootstrap-tags.js\" \"../../../Configuration/**/*.yaml\" \"../../../*.yml\" \"../../../.github/workflows/*.yml\"",
    "format:check": "prettier --check \"*.{js,mjs,json}\" \"../../Public/CSS/*.css\" \"../../Public/Javascript/bootstrap-tags.js\" \"../../../Configuration/**/*.yaml\" \"../../../*.yml\" \"../../../.github/workflows/*.yml\""
  },
  "dependencies": {
    "emojibase-data": "17.0.0",
    "tinymce": "8.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.25.12",
    "prettier": "3.6.2"
  }
}
