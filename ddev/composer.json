{
  "name": "pottkinder/typo3-forum-dev-environment",
  "description": "Minimal TYPO3 14.3 development installation for the local forum extension.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "repositories": [
    {
      "type": "path",
      "url": "packages/typo3_forum",
      "options": {
        "symlink": true,
        "versions": {
          "pottkinder/typo3forum": "dev-v14"
        }
      }
    },
    {
      "type": "path",
      "url": "Packages/typo3_forum_dev",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.4",
    "pottkinder/typo3-forum-dev": "1.0.0",
    "pottkinder/typo3forum": "dev-v14",
    "typo3/cms-install": "^14.3",
    "typo3/cms-fluid-styled-content": "^14.3",
    "typo3/cms-tstemplate": "^14.3",
    "typo3/cms-felogin": "^14.3"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  },
  "extra": {
    "typo3/cms": {
      "web-dir": "public"
    }
  }
}
